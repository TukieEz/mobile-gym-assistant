{
  "$schema": "Module manifest for Claude Code project bootstrap",
  "version": "1.0.0",

  "modules": {
    "memory": {
      "name": "Memory Persistence",
      "description": "Сохраняет контекст и паттерны между сессиями",
      "files": [
        "modules/memory/SKILL.md",
        "modules/memory/hooks/session_start.py",
        "modules/memory/hooks/session_end.py"
      ],
      "hooks": {
        "SessionStart": "modules/memory/hooks/session_start.py",
        "Stop": "modules/memory/hooks/session_end.py"
      },
      "default": true,
      "tags": ["core", "productivity"]
    },

    "strategic-compact": {
      "name": "Strategic Compact",
      "description": "Умное уведомление когда пора сжать контекст",
      "files": [
        "modules/strategic-compact/hooks/tool_counter.py"
      ],
      "hooks": {
        "PostToolUse": "modules/strategic-compact/hooks/tool_counter.py"
      },
      "config": {
        "threshold": 50,
        "reminder_interval": 25
      },
      "default": true,
      "tags": ["core", "context-management"]
    },

    "smart-routing": {
      "name": "Smart Agent Routing",
      "description": "Автоматический выбор агентов по изменённым файлам",
      "files": [
        "modules/smart-routing/SKILL.md",
        "modules/smart-routing/router.py"
      ],
      "requires": ["specialized-agents"],
      "default": false,
      "tags": ["automation", "agents"]
    },

    "specialized-agents": {
      "name": "Specialized Reviewers",
      "description": "Security, A11y, SEO, Performance агенты",
      "files": [
        "modules/specialized-agents/security-reviewer.md",
        "modules/specialized-agents/a11y-auditor.md",
        "modules/specialized-agents/seo-checker.md",
        "modules/specialized-agents/performance.md"
      ],
      "default": false,
      "tags": ["agents", "review"]
    },

    "context-protocol": {
      "name": "Context Protocol",
      "description": "Автозагрузка контекстов по git diff",
      "files": [
        "modules/context-protocol/context-loader.md",
        "modules/context-protocol/context-updater.md"
      ],
      "default": false,
      "tags": ["context-management", "automation"]
    },

    "pre-deploy": {
      "name": "Pre-Deploy Checks",
      "description": "Блокирует деплой при проблемах",
      "files": [
        "modules/pre-deploy/SKILL.md",
        "modules/pre-deploy/checks/"
      ],
      "default": false,
      "tags": ["ci-cd", "safety"]
    },

    "tdd-enforce": {
      "name": "TDD Enforcement",
      "description": "Обязательный RED→GREEN→REFACTOR",
      "files": [
        "modules/tdd-enforce/SKILL.md",
        "modules/tdd-enforce/hooks/pre_edit_tdd.py"
      ],
      "hooks": {
        "PreToolUse": "modules/tdd-enforce/hooks/pre_edit_tdd.py"
      },
      "default": false,
      "tags": ["testing", "discipline"]
    },

    "security-review": {
      "name": "Security Review",
      "description": "8 обязательных проверок безопасности",
      "files": [
        "modules/security-review/SKILL.md",
        "modules/security-review/checklist.md"
      ],
      "default": false,
      "tags": ["security", "review"]
    }
  },

  "presets": {
    "minimal": {
      "name": "Minimal",
      "description": "Только базовое — для скриптов и MVP",
      "modules": ["memory"],
      "triggers": {
        "keywords": ["скрипт", "script", "mvp", "быстро", "простой", "pet project"],
        "loc_max": 5000
      }
    },

    "standard": {
      "name": "Standard",
      "description": "Базовый набор для обычных проектов",
      "modules": ["memory", "strategic-compact", "context-protocol"],
      "triggers": {
        "default": true,
        "loc_range": [5000, 50000]
      }
    },

    "web-frontend": {
      "name": "Web Frontend",
      "description": "Next.js, React — с a11y, seo, performance",
      "extends": "standard",
      "modules": ["specialized-agents", "smart-routing", "pre-deploy"],
      "agent_focus": ["a11y-auditor", "seo-checker", "performance", "design-reviewer"],
      "triggers": {
        "stacks": ["next.js", "react", "vue", "svelte", "frontend"],
        "keywords": ["портфолио", "portfolio", "сайт", "website", "лендинг"]
      }
    },

    "python-backend": {
      "name": "Python Backend",
      "description": "FastAPI, Django — с security и TDD",
      "extends": "standard",
      "modules": ["security-review", "tdd-enforce", "pre-deploy"],
      "agent_focus": ["security-reviewer"],
      "triggers": {
        "stacks": ["python", "fastapi", "django", "flask"],
        "keywords": ["api", "backend", "сервер", "server"]
      }
    },

    "telegram-bot": {
      "name": "Telegram Bot",
      "description": "aiogram с context protocol",
      "extends": "standard",
      "modules": ["context-protocol"],
      "triggers": {
        "stacks": ["aiogram", "telegram", "pyrogram", "telethon"],
        "keywords": ["бот", "bot", "telegram"]
      }
    },

    "full": {
      "name": "Full",
      "description": "Всё включено — для больших production проектов",
      "modules": ["memory", "strategic-compact", "smart-routing", "specialized-agents",
                  "context-protocol", "pre-deploy", "tdd-enforce", "security-review"],
      "triggers": {
        "keywords": ["production", "продакшн", "enterprise", "большой", "команда", "team"],
        "loc_min": 50000
      }
    }
  },

  "stack_detection": {
    "patterns": {
      "next.js": ["next.config", "app/", "pages/", "package.json:next"],
      "react": ["package.json:react", "src/App", ".jsx", ".tsx"],
      "python": [".py", "pyproject.toml", "requirements.txt", "setup.py"],
      "fastapi": ["fastapi", "uvicorn"],
      "telegram": ["aiogram", "pyrogram", "telegram"],
      "supabase": ["supabase/", ".supabase"]
    }
  }
}
